# ============================================================================
# OMNIWATCH — environment template (SAMPLE VALUES ONLY — never real secrets)
# Copy to .env and replace every value. Never commit the real .env file.
# ============================================================================

# --- App --------------------------------------------------------------------
APP_NAME=OmniWatch
APP_ENV=development
DEBUG=false                 # true enables /docs, verbose errors (dev only)
SECRET_KEY=CHANGE-ME-LONG-RANDOM-STRING            # JWT signing (>= 32 chars)
DEMO_MODE=false             # true enables /api/demo scenario runner + banners

# --- Database (compose) -----------------------------------------------------
# App user holds DML rights only. The migrate one-shot uses OMNIWATCH_DB_ADMIN_URL.
DATABASE_URL=postgresql+psycopg2://omniwatch_app:CHANGE-ME-app-pass@db:5432/omniwatch
OMNIWATCH_DB_ADMIN_URL=postgresql+psycopg2://omniwatch_admin:CHANGE-ME-admin-pass@db:5432/omniwatch
# Local SQLite dev (no Postgres needed): DATABASE_URL=sqlite:///./data/omniwatch.db

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# When no broker is reachable the API falls back to running ingestion inline.

# --- Auth -------------------------------------------------------------------
# Local mode (default): Argon2id + our own JWT pairs.
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
JWT_ACTION_TTL_MINUTES=10

# Supabase Auth mode: set SUPABASE_URL and SUPABASE_JWT_SECRET to enable.
# In that mode set DATABASE_URL to your Supabase Postgres pooler connection
# string. Secrets below are SERVER-SIDE ONLY — never ship them to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Optional: used only by scripts/seed_demo.py to provision demo accounts.
SUPABASE_SERVICE_KEY=

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Strict CSP/security headers are on by default; relax only for local HMR if needed.
ENABLE_HSTS=false

# --- Files & uploads --------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_PHOTO_MB=15
MAX_VIDEO_MB=60

# --- Geofence ---------------------------------------------------------------
DEFAULT_GEOFENCE_RADIUS_M=50

# --- CV pipeline ------------------------------------------------------------
# auto  -> use real YOLOv8/ByteTrack when the packages + model are available,
#          otherwise fall back to the deterministic simulator
# real  -> require the real stack (fails loudly if missing)
# sim   -> always use the simulator
CV_MODE=auto
YOLO_MODEL_PATH=            # e.g. ./data/models/yolov8n.pt (auto-download if blank & internet)
CV_SAMPLE_EVERY_FRAMES=5
